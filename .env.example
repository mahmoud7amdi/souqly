APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Souqly (procure2pay rebuild) application settings
# ----------------------------------------------------------------------
APP_TITLE="Souqly ERP"
ADMINISTRATOR_USERNAMES=superadmin
ALLOW_REGISTRATION=true
ASSET_VERSION=1

# Seeded admin account (AdminUserSeeder), required before `php artisan db:seed`.
# The account is unrestricted — `Gate::before()` grants an admin every ability —
# so choose a strong value and never commit it. Login is by username `admin`.
SEED_ADMIN_PASSWORD=

# ----------------------------------------------------------------------
# Progressive web app / offline POS (config/pwa.php)
# ----------------------------------------------------------------------
# PWA_ENABLED is the kill switch for the whole layer: the manifest link, both
# header badges, and the service worker. Setting it to false also *unregisters* a
# worker an earlier visit installed — without that, a till would keep serving
# yesterday's cached terminal forever and the operator who turned the feature off
# would have no way to tell why.
PWA_ENABLED=true

# Offline selling specifically. With PWA_ENABLED=true and this false the app still
# installs and caches its shell, but the POS posts straight to the server and
# queues nothing — the right setting for a shop on a reliable line, because a
# queue nobody watches is takings sitting on one machine.
PWA_OFFLINE_MODE=true

# How often the queue drains itself while the till is online, in seconds. The
# drain also runs on the `online` event and on the connectivity probe's rising
# edge; this is the backstop for a connection that never announced it came back.
PWA_AUTO_SYNC_INTERVAL=60

# How often /api/ping is probed for the header badge, in seconds. `navigator.onLine`
# is not enough on its own: it reports link state, so it says "online" behind a
# captive portal that answers nothing.
PWA_PING_INTERVAL=20

# How many unsynced sales one device may hold before the terminal refuses to take
# another offline. Not a storage limit — a limit on how much money is allowed to
# exist in one browser. Raise it only if the shop is genuinely offline for long
# stretches, and never past what the cashier could re-enter by hand.
PWA_MAX_QUEUED_DOCUMENTS=500
