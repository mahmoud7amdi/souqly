APP_NAME=Souqly
APP_ENV=testing
# Test-only key. It signs nothing but ephemeral test sessions, and is deliberately
# DIFFERENT from the key in .env — this file is tracked, so anything here is public.
APP_KEY=base64:HrHWjGRDJf11gHDEc01LkS5kTyRxD1/I1FNNafdNskc=
APP_DEBUG=true
APP_URL=https://souqly.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=souqly_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Souqly (procure2pay rebuild) application settings
# ----------------------------------------------------------------------
APP_TITLE="Souqly ERP"
ADMINISTRATOR_USERNAMES=superadmin
ALLOW_REGISTRATION=true
ASSET_VERSION=1

# Seeded admin account. Test-only value: it seeds an ephemeral test database and
# protects nothing, so it is safe in version control. The real development
# password lives in .env, which is gitignored. See NOTES.md §12.2.
SEED_ADMIN_PASSWORD="test-only-not-a-secret"

# Pusher / realtime (optional)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Google map (contact / location map screens)
GOOGLE_MAP_API_KEY=

# Progressive web app / offline POS
PWA_ENABLED=true
PWA_OFFLINE_MODE=true

# Backup
BACKUP_DISK=local
